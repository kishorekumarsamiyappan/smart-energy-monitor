# ==============================================================================
# Smart Energy Monitor - Environment Variables Example
# Copy to .env (and web/.env.local) and populate real values.
# NEVER commit real .env files, service-role keys, or production device secrets.
# ==============================================================================

# --- Runtime Environment ---
NODE_ENV=development
PORT=4000
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000

# --- Supabase / PostgreSQL (Backend & Auth) ---
# Get these from Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Backend ONLY! Never expose SUPABASE_SERVICE_ROLE_KEY in web or mobile code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Direct Postgres connection string (used by backend pg pool / migrations)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# JWT secret from Supabase Project Settings -> API -> JWT Settings (or local dev HS256 secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Next.js Public Frontend Variables (web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- EMQX MQTT Broker (Backend Worker) ---
# Production MUST use mqtts:// (MQTT over TLS on port 8883)
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtts://your-emqx-host.emqxsl.com:8883
MQTT_USERNAME=backend-ingestor
MQTT_PASSWORD=replace-with-strong-backend-mqtt-password
MQTT_CLIENT_ID=sem-backend-ingestor-01
MQTT_CA_CERT_PATH=./mqtt/certs/ca.crt
MQTT_REJECT_UNAUTHORIZED=true

# --- Security & Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX=20

# --- Push Notifications (Android FCM - Backend Only) ---
FCM_ENABLED=false
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_JSON_PATH=./secrets/firebase-service-account.json

# --- GitHub Releases FOTA (ESP32-S3 OTA Firmware Updates) ---
# Format: owner/repo (e.g., kishorekumar/smart-energy-monitor-firmware)
GITHUB_FIRMWARE_REPO=
# Optional PAT only if firmware repository is private (backend only)
GITHUB_TOKEN=
